# SQL Server SA Password (minimum 8 chars, uppercase, lowercase, digits, symbols)
DB_SA_PASSWORD=REPLACE_WITH_STRONG_SQL_PASSWORD

# JWT Signing Key (minimum 32 characters)
JWT_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_SECRET_KEY

# Optional Initial Administrator Bootstrap Credentials
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.example
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
