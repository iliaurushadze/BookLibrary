{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(LocalDB)\\MSSQLLocalDB;Database=BookLibraryDb;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "BookLibrary.Api",
    "Audience": "BookLibrary.Client",
    "SecretKey": "REPLACE_IN_ENVIRONMENT_OR_USER_SECRETS_MIN_32_CHARS_LONG",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 14
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Swagger": {
    "Enabled": true
  },
  "AdminBootstrap": {
    "Email": "",
    "Password": "",
    "DisplayName": "System Administrator"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
